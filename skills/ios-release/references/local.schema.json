{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ios-release-local-v2",
  "title": "Machine-local iOS release profile bindings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "apps"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "apps": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ascProfile"],
        "properties": { "ascProfile": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
