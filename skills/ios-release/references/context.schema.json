{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReleaseContextV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "apps"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "defaultApp": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9][A-Za-z0-9._-]*$": {
          "$ref": "#/$defs/app"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "\\.(?:[pP]8|[pP][eE][mM]|[kK][eE][yY])$"
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "\\.(?:[pP]8|[pP][eE][mM]|[kK][eE][yY])$"
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "testflight": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "internalGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "externalGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    },
    "xcodeProject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project"],
      "properties": {
        "project": {
          "$ref": "#/$defs/relativePath"
        },
        "scheme": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "configuration": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "xcodeWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace"],
      "properties": {
        "workspace": {
          "$ref": "#/$defs/relativePath"
        },
        "scheme": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "configuration": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "xcode": {
      "oneOf": [
        {
          "$ref": "#/$defs/xcodeProject"
        },
        {
          "$ref": "#/$defs/xcodeWorkspace"
        }
      ]
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "sourceRoot": {
          "$ref": "#/$defs/relativePath"
        },
        "bundleId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "appId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "platform": {
          "enum": ["IOS"]
        },
        "ascProfile": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "xcode": {
          "$ref": "#/$defs/xcode"
        },
        "testflight": {
          "$ref": "#/$defs/testflight"
        },
        "metadataDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "defaultIntent": {
          "enum": [
            "internal-testflight",
            "external-testflight",
            "app-store-stage",
            "app-store-submit"
          ]
        }
      }
    }
  }
}
